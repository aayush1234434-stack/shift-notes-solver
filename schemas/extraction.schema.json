{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shift note extraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["people", "blocks", "stations", "station_holders", "constraints"],
  "properties": {
    "people": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "blocks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "stations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "station_holders": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "ignored_lines": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "constraints": {"type": "array", "items": {"oneOf": [
      {"$ref": "#/$defs/blockRule"}, {"$ref": "#/$defs/stationRule"},
      {"$ref": "#/$defs/orderRule"}, {"$ref": "#/$defs/betweenRule"}
    ]}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"},
    "sourceLine": {"type": "integer", "minimum": 1},
    "blockRule": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "person", "block", "source", "source_line"],
      "properties": {
        "type": {"enum": ["fixed_block", "not_block"]},
        "person": {"$ref": "#/$defs/text"}, "block": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/text"}, "source_line": {"$ref": "#/$defs/sourceLine"}
      }
    },
    "stationRule": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "person", "station", "source", "source_line"],
      "properties": {
        "type": {"enum": ["fixed_station", "not_station"]},
        "person": {"$ref": "#/$defs/text"}, "station": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/text"}, "source_line": {"$ref": "#/$defs/sourceLine"}
      }
    },
    "orderRule": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "person", "other_person", "source", "source_line"],
      "properties": {
        "type": {"enum": ["before", "after", "immediately_before", "immediately_after", "adjacent", "not_adjacent"]},
        "person": {"$ref": "#/$defs/text"}, "other_person": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/text"}, "source_line": {"$ref": "#/$defs/sourceLine"}
      }
    },
    "betweenRule": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "person", "other_person", "third_person", "source", "source_line"],
      "properties": {
        "type": {"const": "between"}, "person": {"$ref": "#/$defs/text"},
        "other_person": {"$ref": "#/$defs/text"}, "third_person": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/text"}, "source_line": {"$ref": "#/$defs/sourceLine"}
      }
    }
  }
}
